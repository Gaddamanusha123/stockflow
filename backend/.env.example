# Django Configuration
SECRET_KEY=replace-with-secure-key
DEBUG=False
ALLOWED_HOSTS=yourdomain.com,api.yourdomain.com,localhost,127.0.0.1

# PostgreSQL Database Configuration
DB_ENGINE=django.db.backends.postgresql
DB_NAME=stockflow_db
DB_USER=postgres_user
DB_PASSWORD=secure_password
DB_HOST=db_host_or_localhost
DB_PORT=5432

# CORS Configuration
CORS_ALLOWED_ORIGINS=https://stockflow.yourdomain.com,http://localhost:5173

